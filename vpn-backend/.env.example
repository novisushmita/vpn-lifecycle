APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vpn_lifecycle
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email (SMTP) ---
# Lab/dev boleh pakai Mailpit (docker run -d -p 1025:1025 -p 8025:8025
# axllent/mailpit) tanpa ubah apa pun di bawah selain MAIL_PORT=1025 dan
# MAIL_MAILER=smtp, lihat SETUP.md 14b.
#
# Buat kirim email BENERAN (mis. ke device lain / demo sidang), isi 3 baris
# ini pakai akun Gmail pengirim:
#   MAIL_USERNAME     = alamat gmail pengirim
#   MAIL_PASSWORD     = App Password 16 karakter, BUKAN password akun Gmail
#                        biasa (Gmail menolak password biasa lewat SMTP).
#                        Buat di: myaccount.google.com/apppasswords
#                        (butuh verifikasi 2 langkah aktif dulu di akun itu)
#   MAIL_FROM_ADDRESS = WAJIB SAMA dengan MAIL_USERNAME. Gmail menolak/
#                        menandai spam kalau pengirim di header From beda
#                        dengan akun yang login SMTP.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=isi-email-pengirim@gmail.com
MAIL_PASSWORD=isi-app-password-16-karakter
MAIL_FROM_ADDRESS="isi-email-pengirim@gmail.com"
MAIL_FROM_NAME="Layanan VPN"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- MikroTik RouterOS v7 (REST API) ---
# base_url = jalur manajemen host-only (ether2). Lihat SETUP.md bagian 12.
ROUTEROS_BASE_URL=https://192.168.56.2
ROUTEROS_USER=api-laravel
ROUTEROS_PASSWORD=
ROUTEROS_VERIFY_TLS=false
ROUTEROS_TIMEOUT=10
# Harus sama dengan <IPSEC_PSK> di chr-setup.rsc
ROUTEROS_IPSEC_PSK=
# Alamat CHR dari sudut pandang KLIEN L2TP (IP bridged/LAN ether1), bukan base_url
ROUTEROS_VPN_SERVER=
# Harus sama dengan /ip pool di router
ROUTEROS_POOL_RANGE=10.10.20.10-10.10.20.250
ROUTEROS_LOCAL_ADDRESS=10.10.20.1
DB_QUEUE_RETRY_AFTER=300
